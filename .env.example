# Copy to .env for local overrides. Never commit real secrets.
DATABASE_URL=postgres://sara:sara@localhost:54329/sara
SARA_DATA_DIR=./.sara
SARA_PORT=3000
SARA_PUBLIC_URL=http://localhost:5173
SARA_PROFI_MCP_URL=http://localhost:7070/mcp
# Required in production, dev defaults exist:
SARA_NODE_TOKEN=
SARA_PERMIT_SECRET=
SARA_CLAUDE_BIN=claude
# Only for tests with the fake Telegram API:
SARA_TELEGRAM_API_ROOT=
