# The pult's own address, plus older addresses that keep answering (links already sent in Telegram).
{$SARA_DOMAIN} {$SARA_DOMAIN_ALIASES} {
	# /internal is only for Profi-MCP inside Docker; never from outside (T4).
	@internal path /internal/*
	respond @internal 404
	# The pult's live stream (SSE) goes through uncompressed and unbuffered, event by event.
	handle /api/stream {
		reverse_proxy core:3300 {
			flush_interval -1
		}
	}
	handle /api/* {
		encode zstd gzip
		reverse_proxy core:3300
	}
	# The voice app (ADR-028): its own page, with its own manifest for the Home Screen.
	handle /talk {
		encode zstd gzip
		root * /srv
		header Content-Security-Policy "frame-ancestors 'self'"
		rewrite * /talk.html
		file_server
	}
	handle {
		encode zstd gzip
		root * /srv
		# The pult opens as a Telegram Mini App (pult v2 design 7): only Telegram may frame it.
		header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
		# The service worker of Web Push is never kept stale.
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
