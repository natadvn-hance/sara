(sara) {
	encode zstd gzip
	# /internal is only for Profi-MCP inside Docker; never from outside (T4).
	@internal path /internal/*
	respond @internal 404
	handle /api/* {
		reverse_proxy core:3300
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$SARA_DOMAIN} {
	import sara
}

# Plain HTTP for the entry server only, over the WireGuard tunnel (infra/front); bound to the tunnel address.
http://:8080 {
	import sara
}
