{
  "name": "sara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check . && pnpm -r typecheck && tsx scripts/check-dash.ts",
    "test": "vitest run",
    "format": "biome check --write .",
    "role:eval": "pnpm --filter @sara/core role:eval",
    "fake:order": "curl -s -X POST http://127.0.0.1:7070/fake/orders",
    "probe:claude": "pnpm --filter @sara/core probe:claude",
    "trace": "tsx scripts/trace.ts",
    "mind:check": "tsx scripts/mind-check.ts",
    "dev": "tsx scripts/dev.ts",
    "smoke:claude-container": "bash scripts/smoke-claude-container.sh",
    "report:speed": "pnpm --filter @sara/core report:speed",
    "bids:on": "pnpm --filter @sara/core bids bids on",
    "bids:off": "pnpm --filter @sara/core bids bids off",
    "claude:token": "bash scripts/save-claude-token.sh",
    "leads:on": "pnpm --filter @sara/core bids leads on",
    "leads:off": "pnpm --filter @sara/core bids leads off",
    "check:ports": "tsx scripts/check-ports.ts",
    "deploy": "bash scripts/deploy.sh",
    "profi:samples": "tsx scripts/profi-samples.ts",
    "report:shadow": "pnpm --filter @sara/core report:shadow"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@sara/shared": "workspace:*",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
